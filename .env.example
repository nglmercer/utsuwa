# Database connection (required for Companion System V2)
# For local development with Docker Compose:
DATABASE_URL=postgresql://utsuwa:utsuwa@localhost:5432/utsuwa

# Alternative: Use your own PostgreSQL instance
# DATABASE_URL=postgresql://user:password@localhost:5432/utsuwa

# MCP (Model Context Protocol) tool support — all off by default.
# Enables the /api/mcp proxy routes (required for web chat tool use):
# MCP_ENABLED=server
# Allowlist for stdio servers (comma-separated command basenames or paths).
# Unset/empty refuses every stdio server (fail-closed):
# MCP_STDIO_ALLOWED_COMMANDS=uvx,npx
# Append the tool-safety suffix to the system prompt while MCP tools are attached:
# PUBLIC_MCP_PROMPT_HARDENING=true
# Tools that are never auto-executed (comma-separated server__tool or bare names):
# PUBLIC_MCP_CONFIRM_TOOLS=home__assistant_command
