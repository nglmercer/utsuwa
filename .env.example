# Database connection (required for Companion System V2)
# For local development with Docker Compose:
DATABASE_URL=postgresql://utsuwa:utsuwa@localhost:5432/utsuwa

# Alternative: Use your own PostgreSQL instance
# DATABASE_URL=postgresql://user:password@localhost:5432/utsuwa

# MCP (Model Context Protocol) tool support — all off by default.
# Enables the /api/mcp proxy routes (required for web chat tool use):
# MCP_ENABLED=server
# Stdio server inventory (JSON array). The proxy has no login, so a stdio
# server's command, argv, and env MUST be pinned here by the operator — the
# browser client only names a server `id`, and anything else it sends is
# discarded. A server id with no entry is refused. Unset/empty/invalid =
# every stdio server refused (fail-closed).
# Example (single line, no newlines):
# MCP_STDIO_SERVERS=[{"id":"time","command":"uvx","args":["mcp-server-time"],"env":{"TZ":"UTC"}}]
# Backstop allowlist for the resolved inventory commands (comma-separated
# command basenames or paths). Keep it minimal — every entry must ALSO be in
# the inventory above to run. Unset/empty refuses every stdio server:
# MCP_STDIO_ALLOWED_COMMANDS=uvx
# WARNING: never allowlist an interpreter or package runner (uvx, npx, bunx,
# pipx, python*, node, deno, ruby, perl, sh, ...) WITHOUT a matching pinned
# inventory entry — client-controlled argv would turn it into remote code
# execution. Prefer fixed, non-interpreter binaries where possible.
# Append the tool-safety suffix to the system prompt while MCP tools are attached:
# PUBLIC_MCP_PROMPT_HARDENING=true
# Tools that are never auto-executed (comma-separated server__tool or bare names):
# PUBLIC_MCP_CONFIRM_TOOLS=home__assistant_command
